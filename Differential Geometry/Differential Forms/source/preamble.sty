\newcommand{\surject}{%
  \mathrel{\tikz[baseline=-0.5ex] \draw [thick, line cap=round, -{To[length=2.5pt] To[length=2.5pt]}] (0,0) -- (1em,0);}
}

\newcommand{\inject}{%
  \mathrel{\tikz[baseline=-0.5ex] \draw [thick, line cap=round, {To[reversed, length=2.5pt]}-{To[length=2.5pt]}] (0,0) -- (1em,0);}
}

\newcommand{\biject}{%
  \mathrel{\tikz[baseline=-0.5ex] \draw [thick, line cap=round, {To[reversed, length=2.5pt]}-{To[length=2.5pt] To[length=2.5pt]}] (0,0) -- (1em,0);}
